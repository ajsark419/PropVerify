# Copy this file to `.env` and fill in real values for local development.
# Do NOT commit your real .env file.

# Required: a long random string used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the default seeded admin account (created on first boot).
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!

# Optional: change the port the dev server listens on (defaults to 5000).
PORT=5000
